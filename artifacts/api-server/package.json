{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:hidden-info": "tsx ./src/tests/hidden-info.test.ts",
    "test:recap-privacy": "tsx ./src/tests/recap-privacy.test.ts",
    "test:effect-announcements": "tsx ./src/tests/effect-announcements.test.ts",
    "test:effect-operation-trace": "tsx ./src/tests/effect-operation-trace.test.ts",
    "test:effect-structured-facts": "tsx ./src/tests/effect-structured-facts.test.ts && tsx ../compost-heroes/src/lib/effectAnnouncements.test.ts",
    "test:bot-worm-party": "tsx ./src/tests/bot-worm-party.test.ts",
    "test:route-worm-party": "tsx ./src/tests/route-worm-party.test.ts",
    "test:route-soggy-pile": "tsx ./src/tests/route-soggy-pile.test.ts",
    "test:decision-coverage": "tsx ./src/tests/decision-coverage.test.ts",
    "test:bot-takeover": "tsx ./src/tests/bot-takeover.test.ts",
    "test:route-facilitated-kick": "tsx ./src/tests/route-facilitated-kick.test.ts",
    "test:events": "tsx ./src/tests/route-events.test.ts",
    "test:replay": "NODE_ENV=test tsx ./src/tests/route-replay.test.ts",
    "test:event-delete": "tsx ./src/tests/route-event-delete.test.ts",
    "test:auth-rate-limit": "tsx ./src/tests/auth-rate-limit.test.ts",
    "test:auth-session-expiry": "tsx ./src/tests/auth-session-expiry.test.ts",
    "test:card-image-validation": "tsx ./src/tests/card-image-validation.test.ts",
    "test:database-backup": "tsx ./src/tests/database-backup.test.ts",
    "test:event-stream-ticket": "tsx ./src/tests/event-stream-ticket.test.ts",
    "test:event-stream-auth": "tsx ./src/tests/event-stream-auth.test.ts",
    "test:health-readiness": "tsx ./src/tests/health-readiness.test.ts",
    "test:health-readiness-db": "RUN_DEV_DB_HEALTH_INTEGRATION=1 tsx ./src/tests/health-readiness-db-integration.test.ts",
    "test:startup-readiness": "tsx ./src/tests/startup-readiness.test.ts",
    "test:hot-pile-legion": "tsx ./src/tests/hot-pile-legion.test.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@google-cloud/storage": "^7.16.0",
    "@replit/connectors-sdk": "^0.3.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
